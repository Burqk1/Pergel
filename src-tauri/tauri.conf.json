{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pergel",
  "version": "0.1.0",
  "identifier": "dev.burqk1.pergel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pergel",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "label": "main",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Burqk1",
    "copyright": "\u00c2\u00a9 2026 Burqk1"
  }
}